@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  @apply bg-dark text-light font-sans;
}

.gradient-text {
  @apply bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-600;
}

.btn-primary {
  @apply bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-md font-medium transition-all;
}

.btn-secondary {
  @apply bg-gray-800 hover:bg-gray-700 text-white px-6 py-3 rounded-md font-medium transition-all border border-gray-700;
}

